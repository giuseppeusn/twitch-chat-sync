{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://*.cloudfront.net/*",
    "https://*.jtvnw.net/*",
    "https://*.ttvnw.net/*",
    "https://*.ytimg.com/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "src/content/constants.js",
        "src/content/i18n.js",
        "src/content/storage.js",
        "src/content/state.js",
        "src/content/utils.js",
        "src/content/sync/signature.js",
        "src/content/sync/storyboard.js",
        "src/content/sync/alignment.js",
        "src/content/sync/refinement.js",
        "src/content/chat/loader.js",
        "src/content/chat/renderer.js",
        "src/content/ui/overlay.js",
        "src/content/ui/panel.js",
        "src/content/player/listeners.js",
        "src/content/index.js"
      ],
      "css": ["src/styles/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
